import numpy as np
from scipy.integrate import trapezoid, cumulative_trapezoid

data = np.genfromtxt("COBICAR.lobster", skip_header=77)
energy, columns = data[:, 0], data[:, 1:]
below = energy < 0
i_f = np.argmin(np.abs(energy))
TARGET = 0.048843832296207715

# (a) which columns integrate below E_F to the target?
integ = trapezoid(columns[below], energy[below], axis=0)
print("integrate to target:", np.flatnonzero(np.abs(integ - TARGET) < 1e-3) + 1)

# (b) which columns *are* the target, read at E_F? (ICOBI columns)
print("equal target at E_F: ", np.flatnonzero(np.abs(columns[i_f] - TARGET) < 1e-3) + 1)

# (c) is column c+1 the running integral of column c?
run = cumulative_trapezoid(columns, energy, axis=0, initial=0.0)
err = np.abs(run[:, :-1] - columns[:, 1:]).max(axis=0)
scale = np.abs(columns[:, 1:]).max(axis=0) + 1e-30
print("self-consistent pairs:", np.flatnonzero(err / scale < 5e-2)[:20] + 1)

